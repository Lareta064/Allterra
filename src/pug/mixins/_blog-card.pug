mixin blog-card-ui(img, meta, txt, desk, loc)
	.blog-card.img-zoom
		.blog-card__img
			+pic-short(img, 295, 194, 'wh-100')
			//- img.wh-100.lazy(src="../img/blog/"+ img+".webp", width="295" height="194" alt="img")
		a(href="#!").blog-card__text
			.blog-card__info.txt-14
				if meta!=''
					span #{meta}
					time(datetime="2024-03-12") 12.03.2024
				if loc
					span.pin-item #{loc}
			h3.txt-16 !{txt}
			if desk !=''
